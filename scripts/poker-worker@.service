# Toggleable solve-gen tables worker for a shared box. Instance = manifest
# name: `poker-worker@lines-mtt89` runs manifests/lines-mtt89.toml. Politeness
# is the idle scheduling class, expressed natively (same policy as
# scripts/idle-run.sh — see docs/shared-machine-data-gen.md). Workers sharing
# one --out dir (e.g. NFS) coordinate through the per-flop .jsonl gate; no
# stride needed.
#
# Install (per-user, zero privilege):
#   mkdir -p ~/.config/systemd/user
#   cargo build -p solve-gen --release    # ExecStart is the binary, not cargo
#   cp scripts/poker-worker@.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now poker-worker@lines-mtt89
#   loginctl enable-linger "$USER"        # keep running while logged out
# Toggle / status:
#   systemctl --user stop poker-worker@lines-mtt89
#   systemctl --user restart poker-worker@lines-mtt89
#   systemctl --user start poker-worker@lines-mtt89
#   journalctl --user -u poker-worker@lines-mtt89 -f
#
# TERM stops, HUP drains. Stop frees the worker's resources immediately and the
# unfinished flop is safely re-solved next time; restart drains that flop before
# replacing the process. Rebuild before either, and deploy the binary before
# this unit file — ExecStart is the binary. Why those two signals, why not
# `cargo run`, and how to escalate a drain that will not finish:
# docs/shared-machine-data-gen.md.
#
# Expects ~/src/poker-trainer (checkout, built --release) and ~/poker-tables
# (output dir or symlink). The manifest finishing is exit 0 => service inactive.

[Unit]
Description=Poker solve-gen tables worker (%i)
# Cap restart storms: >3 starts in 5 min stops the unit. The in-job memory
# budget should prevent a deterministic wedge, but nothing should hammer a
# shared box unattended. Clear a tripped limiter with `reset-failed`.
StartLimitIntervalSec=300
StartLimitBurst=3
# ~/poker-tables must resolve (NFS mounted) before starting. The check stats
# through the symlink, and an assert failure does not feed Restart=on-failure
# the way a failing ExecStartPre would.
AssertPathIsDirectory=%h/poker-tables

[Service]
Type=simple
WorkingDirectory=%h/src/poker-trainer
# The prebuilt binary, deliberately not `cargo run`: solve-gen has to be this
# unit's MAIN process or RestartKillSignal never reaches it. A missing binary
# needs no guard — ExecStart fails 203/EXEC and names the path.
ExecStart=%h/src/poker-trainer/target/release/solve-gen tables --manifest manifests/%i.toml --no-save-bins --out %h/poker-tables
# Idle class: runs only on otherwise-free cores, yields instantly. No Nice=,
# which SCHED_IDLE ignores.
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
# Backstop only: a contained cgroup kill of *our* process instead of the global
# OOM killer picking a victim on a shared box. The real guard is the in-job
# memory budget (auto: 80% of MemAvailable, or `tables --max-mem`), which skips
# an oversized flop before allocating. 50% of physical suits a normally-shared
# box; tune down on one that runs persistently hot.
MemoryMax=50%
# Stop preempts: SIGTERM is uncatchable here, freeing the cgroup now, and the
# interrupted flop stays absent (tmp+rename) for the .jsonl gate to re-solve.
# Restart drains: solve-gen handles SIGHUP between flops. TimeoutStopSec governs
# both paths with no per-operation knob, so it stays infinite — the drain is
# worth waiting out and the stop path needs no deadline.
KillSignal=SIGTERM
RestartKillSignal=SIGHUP
KillMode=control-group
TimeoutStopSec=infinity
# Crash => restart resumes via the .jsonl gate; manifest done => stays off. An
# over-budget flop now prints `SKIPPED:` in the journal and is retried later on
# a less-loaded box — it no longer wedges the worker.
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
