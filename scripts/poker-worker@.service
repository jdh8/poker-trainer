# Toggleable solve-gen tables worker for a shared box. Instance = manifest
# name: `poker-worker@lines-mtt89` runs manifests/lines-mtt89.toml. Politeness
# is the idle scheduling class, expressed natively (same policy as
# scripts/idle-run.sh — see docs/shared-machine-data-gen.md). Workers sharing
# one --out dir (e.g. NFS) coordinate through the per-flop .jsonl gate; no
# stride needed.
#
# Install (per-user, zero privilege):
#   mkdir -p ~/.config/systemd/user
#   cp scripts/poker-worker@.service ~/.config/systemd/user/
#   cp -r scripts/poker-worker@.service.d ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now poker-worker@lines-mtt89
#   loginctl enable-linger "$USER"        # keep running while logged out
# Toggle / status:
#   systemctl --user stop --no-block poker-worker@lines-mtt89
#   systemctl --user start poker-worker@lines-mtt89
#   journalctl --user -u poker-worker@lines-mtt89 -f
# Stop drains the current flop, then exits before starting another. --no-block
# returns at once instead of holding the terminal for the drain (Ctrl-C on a
# plain `stop` also just detaches the client; the job continues). Emergency
# stop (discard current-flop work immediately) — stop first, else the SIGKILL
# reads as a failure and Restart= brings the worker back a minute later:
#   systemctl --user stop --no-block poker-worker@lines-mtt89
#   systemctl --user kill --kill-whom=all --signal=SIGKILL poker-worker@lines-mtt89
#
# Expects ~/src/poker-trainer (checkout) and ~/poker-tables (output dir or
# symlink). The manifest finishing is exit 0 => the service goes inactive.

[Unit]
Description=Poker solve-gen tables worker (%i)
After=network-online.target
# Cap restart storms: >3 starts in 5 min stops the unit. The in-job memory
# budget should prevent a deterministic wedge, but nothing should hammer a
# shared box unattended. Clear a tripped limiter with `reset-failed`.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/src/poker-trainer
# ~/poker-tables must resolve (NFS mounted) before starting.
ExecStartPre=/bin/sh -c 'test -d "$(readlink -f %h/poker-tables)"'
# sh -lc: pick up cargo wherever it lives (snap, rustup, ...).
ExecStart=/bin/sh -lc 'exec cargo run -p solve-gen --release -- tables --manifest manifests/%i.toml --no-save-bins --out %h/poker-tables'
# Idle class: runs only on otherwise-free cores, yields instantly.
Nice=10
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
# Backstop only: a contained cgroup kill of *our* process instead of the global
# OOM killer picking a victim on a shared box. The real guard is the in-job
# memory budget (auto: 80% of MemAvailable, or `tables --max-mem`), which skips
# an oversized flop before allocating. 50% of physical suits a normally-shared
# box; tune down on one that runs persistently hot.
MemoryMax=50%
# SIGTERM requests an nginx-style drain: finish and atomically publish the
# current flop, then exit before starting another. `cargo run` and solve-gen
# are both in this cgroup, so signal the whole group. Two minutes is a drain
# window, not a guarantee: a flop still solving when it expires is force-killed
# and simply re-solved on the next run (the publish is tmp+rename, so nothing
# partial lands and the per-flop .jsonl gate re-queues it). Bounding the wait
# beats saving one flop's CPU on a shared box. Force-kill rather than inherit a
# distro SIGABRT policy that would core-dump a many-GB solver onto the same
# disk as the tables — the accompanying unit-specific drop-in repeats the
# failure mode so it wins over Fedora's global service.d/10-timeout-abort.conf.
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=2min
TimeoutStopFailureMode=kill
# Crash => restart resumes via the .jsonl gate; manifest done => stays off. An
# over-budget flop now prints `SKIPPED:` in the journal and is retried later on
# a less-loaded box — it no longer wedges the worker.
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
